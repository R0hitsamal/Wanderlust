<% if (error && error.length) { %>
    <br />
    <div class="alert alert-warning alert-dismissible fade show col-8 offset-2  " role="alert">
      <%= error %>
      <button
        type="button"
        class="btn-close"
        aria-label="close"
        data-bs-dismiss="alert"
      ></button>
    </div>
    <% } %>