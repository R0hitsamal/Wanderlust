<% layout("/layouts/boilerplate") %>
<body>
  <div class="row">
    <div class="col-6 offset-3">
      <h3 class="mt-3 mb-3">LogIn on Wanderlust</h3>
      <form
        class="needs-validation"
        novalidate
        method="post"
        action="http://localhost:6060/login"
      >
        <div class="form-group mb-3">
          <label for="username">Username<span class="redstar"> *</span></label>
          <input
            required
            type="text"
            class="form-control border-3"
            id="username"
            name="username"
            placeholder="Enter username"
          />
        </div>
        <div class="form-group mb-3">
          <label for="password">Password<span class="redstar"> *</span></label>
          <input
            required
            type="password"
            class="form-control border-3"
            id="password"
            name="password"
            placeholder="Enter password"
          />
        </div>
        <a href="/signup" class="signup-link"
          ><p class="text-center">Don't have an account</p></a
        >
        <div class="form-check mb-4">
          <input
            required
            type="checkbox"
            class="form-check-input"
            id="exampleCheck1"
          />
          <label class="form-check-label" for="exampleCheck1">Confirm</label>
        </div>
        <div class="text-center">
          <button class="btn text">LogIn</button>
        </div>
      </form>
    </div>
  </div>
</body>
